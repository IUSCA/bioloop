generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dataset {
  id                Int      @id @default(autoincrement())
  name              String
  type              String
  num_directories   Int?
  num_files         Int?
  du_size           BigInt?
  size              BigInt?
  bundle_size       BigInt?
  description       String?
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(6)
  origin_path       String?
  archive_path      String?
  staged_path       String?
  is_deleted        Boolean  @default(false)
  is_staged         Boolean  @default(false)
  metadata          Json?
  src_instrument_id Int?
  // The group that governs this dataset. The database default is the seeded
  // 'Unassigned Datasets' group, so a caller that names no group still produces a row with
  // an owner. datasets_v2 refuses without an explicit group, so only legacy callers reach
  // the default.
  // @see docs/design/groups/dataset-storage.md — What group scoping changed
  // @see docs/design/groups/decisions.md — 2. Every dataset has an owning group
  owner_group_id    String   @default("ffffffff-0000-4000-8000-000000000001")
  // The owning group at the moment the archive was written, stamped beside archive_path and
  // never recomputed. owner_group_id can change afterwards; the tape object does not move.
  // @see docs/design/groups/dataset-storage.md — Archival
  archive_group_key String?

  workflows        workflow[]
  files            dataset_file[]
  audit_logs       dataset_audit[]
  states           dataset_state[]
  derived_datasets dataset_hierarchy[] @relation("source_datasets")
  source_datasets  dataset_hierarchy[] @relation("derived_datasets")
  projects         project_dataset[]
  accesses         data_access_log[]
  stage_requests   stage_request_log[]
  bundle           bundle?
  src_instrument   instrument?         @relation(fields: [src_instrument_id], references: [id])

  owner_group    group                       @relation(fields: [owner_group_id], references: [id], onDelete: Restrict)
  collections    collection_dataset[]
  contributions  user_dataset_contribution[]
  resource_id    String                      @unique
  // Restrict: prevents deleting a resource row directly while this dataset still references it.
  // Reverse cascade (dataset deleted → resource deleted) is enforced via a DB trigger:
  //   AFTER DELETE ON "dataset" FOR EACH ROW: IF resource_id IS NOT NULL THEN DELETE FROM resource WHERE id = OLD.resource_id
  resource       resource                    @relation(fields: [resource_id], references: [id], onDelete: Restrict)
  // @@index([resource_id])
  create_method  DATASET_CREATE_METHOD?
  upload_logs    dataset_upload_log[]
  import_logs    dataset_import_log[]
  use_conditions dataset_use_condition[]
  funding        dataset_funding[]
  affiliations   dataset_affiliation[]

  // Names are unique within an owning group, not globally, so two groups may hold a dataset
  // of the same name without either being able to discover the other.
  // @see docs/design/groups/dataset-storage.md — What group scoping changed
  @@unique([owner_group_id, name, type, is_deleted])
  @@index([owner_group_id])
  @@index([resource_id])
}

model dataset_hierarchy {
  source_id       Int
  derived_id      Int
  assigned_at     DateTime @default(now()) @db.Timestamp(6)
  source_dataset  dataset  @relation(name: "source_datasets", fields: [source_id], references: [id], onDelete: Cascade)
  derived_dataset dataset  @relation(name: "derived_datasets", fields: [derived_id], references: [id], onDelete: Cascade)

  @@id([source_id, derived_id])
}

model dataset_file {
  id         Int                      @id @default(autoincrement())
  name       String?
  path       String
  md5        String?
  size       BigInt?
  filetype   String?
  metadata   Json?
  status     String?
  dataset_id Int
  dataset    dataset                  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  parents    dataset_file_hierarchy[] @relation("child")
  children   dataset_file_hierarchy[] @relation("parent")
  accesses   data_access_log[]

  @@unique([path, dataset_id])
  @@index([dataset_id])
}

model dataset_file_hierarchy {
  parent_id Int
  child_id  Int
  parent    dataset_file? @relation(name: "parent", fields: [parent_id], references: [id], onDelete: Cascade)
  child     dataset_file? @relation(name: "child", fields: [child_id], references: [id], onDelete: Cascade)

  @@id([parent_id, child_id])
  @@index([child_id])
}

model dataset_upload_log {
  id          Int           @id @default(autoincrement())
  status      upload_status
  process_id  String? // Generic upload identifier (TUS ID, S3 key, etc.)
  retry_count Int           @default(0) // Track workflow retry attempts
  metadata    Json? // { checksum?: {...}, failure_reason?: "...", worker_process_id?: ... }
  updated_at  DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  dataset     dataset       @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  dataset_id  Int

  @@unique([dataset_id])
}

model dataset_import_log {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  source_run String?
  notes      String?
  metadata   Json?
  dataset    dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  dataset_id Int

  @@index([dataset_id])
}

model dataset_audit {
  id         Int      @id @default(autoincrement())
  action     String
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  timestamp  DateTime @default(now())
  old_data   Json?
  new_data   Json?
  user_id    Int?
  user       user?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  dataset_id Int?
  dataset    dataset? @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
}

model dataset_state {
  state      String
  timestamp  DateTime @default(now()) @db.Timestamp(6)
  metadata   Json?
  dataset_id Int
  dataset    dataset? @relation(fields: [dataset_id], references: [id], onDelete: Cascade)

  @@id([timestamp, dataset_id, state])
}

model bundle {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  name       String
  size       BigInt?
  md5        String
  dataset_id Int      @unique
  dataset    dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
}

model data_access_log {
  id           Int           @id @default(autoincrement())
  timestamp    DateTime      @default(now()) @db.Timestamp(6)
  access_type  access_type
  file_id      Int?
  dataset_file dataset_file? @relation(fields: [file_id], references: [id])
  dataset_id   Int?
  dataset      dataset?      @relation(fields: [dataset_id], references: [id])
  user_id      Int?
  user         user?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model stage_request_log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamp(6)
  dataset_id Int?
  dataset    dataset? @relation(fields: [dataset_id], references: [id])
  user_id    Int?
  user       user?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model user {
  id                        Int                 @id @default(autoincrement())
  username                  String              @unique @db.VarChar(100)
  name                      String?             @db.VarChar(100)
  email                     String              @unique @db.VarChar(100)
  cas_id                    String?             @unique @db.VarChar(100)
  notes                     String?
  created_at                DateTime            @default(now()) @db.Timestamp(6)
  updated_at                DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  is_deleted                Boolean             @default(false)
  metadata                  Json?
  user_role                 user_role[]
  settings                  user_settings?
  contacts                  contact[]
  dataset_audit             dataset_audit[]
  projects                  project_user[]      @relation("project_user_user")
  password                  user_password?
  login                     user_login?
  accesses                  data_access_log[]
  stage_requests            stage_request_log[]
  about_edits               about[]
  project_users_assigned    project_user[]      @relation("project_user_assignor")
  project_datasets_assigned project_dataset[]
  project_contacts_assigned project_contact[]
  initiated_workflows       workflow[]          @relation("initiated_workflows")
  invitations_sent          group_invitation[]  @relation("invitations_sent")
  notifications             notification[]
  owned_projects            project[]
  // created_datasets           dataset_create_log[]
  alerts_created            alert[]

  // Every membership row, open and closed. Named for what it is: policies must not read this
  // directly, because a closed row still confers nothing. The hydrator exposes the filtered
  // view under the attribute `group_memberships`.
  // @see docs/design/groups/decisions.md — 1. Membership and collection history are preserved
  group_membership_history    group_user[]                @relation("user_memberships")
  memberships_assigned        group_user[]                @relation("membership_assignor")
  memberships_removed         group_user[]                @relation("membership_remover")
  collection_datasets_added   collection_dataset[]        @relation("collection_dataset_adder")
  collection_datasets_removed collection_dataset[]        @relation("collection_dataset_remover")
  grants_created              grant[]                     @relation("grants_created")
  grants_revoked              grant[]                     @relation("grants_revoked")
  access_requests             access_request[]            @relation("access_requests_created")
  access_requests_reviewed    access_request[]            @relation("access_requests_reviewed")
  authorization_audits        authorization_audit[]
  contributions               user_dataset_contribution[]
  subject_id                  String                      @unique
  // Restrict: prevents deleting a subject row directly while this user still references it.
  // Reverse cascade (user deleted → subject deleted) is enforced via a DB trigger:
  //   AFTER DELETE ON "user" FOR EACH ROW: DELETE FROM subject WHERE id = OLD.subject_id
  subject                     subject                     @relation(fields: [subject_id], references: [id], onDelete: Restrict)
  owned_import_sources        import_source[]
  requested_import_sources    import_source[]             @relation("import_source_requester")
  approved_import_sources     import_source[]             @relation("import_source_approver")

  @@index([subject_id])
}

model user_password {
  id         Int      @id @default(autoincrement())
  password   String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id    Int      @unique
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_login {
  id         Int      @id @default(autoincrement())
  last_login DateTime @default(now()) @db.Timestamp(6)
  method     String
  user_id    Int      @unique
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_settings {
  id       Int  @id @default(autoincrement())
  user_id  Int  @unique
  settings Json
  users    user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model notification {
  id         String   @id @default(uuid())
  user_id    Int
  type       String
  title      String
  body       String?
  payload    Json
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([user_id, created_at])
}

model contact {
  id          Int               @id @default(autoincrement())
  type        String
  value       String
  description String?
  user_id     Int?
  user        user?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects    project_contact[]

  @@unique([type, value])
}

model role {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(50)
  description String      @default("") @db.VarChar(255)
  user_role   user_role[]
}

model user_role {
  user_id     Int
  role_id     Int
  roles       role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_at DateTime @default(now())

  @@id([user_id, role_id])
}

model workflow {
  id               String           @id
  dataset_id       Int?
  dataset          dataset?         @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  initiator_id     Int?
  initiator        user?            @relation("initiated_workflows", fields: [initiator_id], references: [id], onDelete: SetNull)
  metadata         Json?
  worker_processes worker_process[]
}

model metric {
  timestamp   DateTime @default(now()) @db.Timestamp(6)
  measurement String
  subject     String
  usage       BigInt?
  limit       BigInt?
  fields      Json?
  tags        Json?

  @@id([timestamp, measurement, subject])
}

model project {
  id              String            @id @default(uuid())
  slug            String            @unique
  name            String
  description     String?
  browser_enabled Boolean           @default(false)
  funding         String?
  metadata        Json?
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  owner_id        Int?
  owner           user?             @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  users           project_user[]
  datasets        project_dataset[]
  contacts        project_contact[]
}

model project_user {
  project_id  String
  user_id     Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  assignor_id Int?
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade, name: "project_user_user")
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull, name: "project_user_assignor")

  @@id([project_id, user_id])
}

model project_dataset {
  project_id  String
  dataset_id  Int
  assignor_id Int?
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  dataset     dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull)

  @@id([project_id, dataset_id])
}

model project_contact {
  project_id  String
  contact_id  Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  assignor_id Int?
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  contact     contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull)

  @@id([project_id, contact_id])
}

model log {
  id                Int            @id @default(autoincrement())
  timestamp         DateTime       @default(now()) @db.Timestamp(6)
  message           String
  level             String
  worker_process_id Int
  worker_log        worker_process @relation(fields: [worker_process_id], references: [id], onDelete: Cascade)

  @@index([worker_process_id])
}

model worker_process {
  id          Int       @id @default(autoincrement())
  pid         Int
  task_id     String
  step        String
  workflow_id String?
  workflow    workflow? @relation(fields: [workflow_id], references: [id])
  tags        Json?
  start_time  DateTime  @default(now()) @db.Timestamp(6)
  hostname    String
  logs        log[]
}

model about {
  id                 Int      @id @default(autoincrement())
  html               String
  created_at         DateTime @default(now()) @db.Timestamp(6)
  last_updated_by    user?    @relation(fields: [last_updated_by_id], references: [id], onDelete: SetNull)
  last_updated_by_id Int?
}

model nonce {
  id         String    @id @default(uuid())
  created_at DateTime  @default(now()) @db.Timestamp(6)
  purpose    String?
  expires_at DateTime?
}

model instrument {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  host             String    @unique
  description      String?
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  sourced_datasets dataset[]
}

model alert {
  id            Int        @id @default(autoincrement())
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  created_by_id Int?
  created_by    user?      @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  label         String?
  message       String?
  type          ALERT_TYPE
  start_time    DateTime?  @db.Timestamp(6)
  end_time      DateTime?  @db.Timestamp(6)
  is_hidden     Boolean?   @default(false)
}

// ============================================================================
// Hierarchical Groups, Collections, and Data Access Control Models
// ============================================================================

// ============================================================================
// RESOURCE / SUBJECT - Common parent tables for real FK integrity
// ============================================================================

enum RESOURCE_TYPE {
  DATASET
  COLLECTION
}

enum SUBJECT_TYPE {
  USER
  GROUP
}

model resource {
  id   String        @id @default(uuid())
  type RESOURCE_TYPE

  dataset         dataset?
  collection      collection?
  grants          grant[]
  access_requests access_request[]
  restrictions    restriction[]
}

model subject {
  id   String       @id @default(uuid())
  type SUBJECT_TYPE

  user                 user?
  group                group?
  grants               grant[]
  access_requests      access_request[]
  applied_restrictions restriction[]    @relation("restriction_applier")
  lifted_restrictions  restriction[]    @relation("restriction_lifter")

  recorded_use_conditions dataset_use_condition[] @relation("use_condition_recorder")
}

// created everyone group and added rules to protect modification in migration script
model group {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  // Immutable directory name for this group's archives. Derived from the slug at creation
  // and never updated, because slug is regenerated whenever the group is renamed and an
  // archive layout built on it would fragment on the first rename.
  // @see docs/design/groups/dataset-storage.md — Archival
  archive_key String  @unique
  description String?

  // Lifecycle
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  archived_at DateTime? @db.Timestamp(6)
  // Denormalisation of "has an open ARCHIVED restriction", kept for listings, the archived
  // filter, and the UI badge. The restriction table is what evaluation reads; these two are
  // written in the same transaction and a test asserts they agree.
  // @see docs/design/groups/decisions.md — 6. Restrictions compose by AND; grants stay additive
  is_archived Boolean   @default(false)
  version     Int       @default(1) // For optimistic concurrency control

  // Settings
  allow_user_contributions Boolean @default(false)
  metadata                 Json?

  // Relations
  restrictions      restriction[]
  members           group_user[]
  ancestor_edges    group_closure[]             @relation("group_descendants")
  descendant_edges  group_closure[]             @relation("group_ancestors")
  owned_datasets    dataset[]
  owned_collections collection[]
  contributions     user_dataset_contribution[]
  // Restrict: prevents deleting a subject row directly while this group still references it.
  // Reverse cascade (group deleted → subject deleted) is enforced via a DB trigger:
  //   AFTER DELETE ON "group" FOR EACH ROW: DELETE FROM subject WHERE id = OLD.id
  subject           subject                     @relation(fields: [id], references: [id], onDelete: Restrict)
  issued_grants     grant[]                     @relation("grant_issuing_authority")
  revoked_grants    grant[]                     @relation("grant_revoking_authority")

  affiliated_datasets dataset_affiliation[] @relation("dataset_affiliation_group")
  import_sources      import_source[]
  groupInvitations    group_invitation[]
}

// Closure table for efficient hierarchy traversal
model group_closure {
  ancestor_id   String
  descendant_id String
  depth         Int

  ancestor   group @relation("group_ancestors", fields: [ancestor_id], references: [id], onDelete: Cascade)
  descendant group @relation("group_descendants", fields: [descendant_id], references: [id], onDelete: Cascade)

  @@id([ancestor_id, descendant_id])
  @@index([descendant_id, depth])
  @@index([ancestor_id, depth])
}

// Group membership with roles.
//
// Rows are closed, never deleted, so that effective access can be reconstructed for a past
// date. `assigned_at` opens the interval; it closes at the earlier of `valid_until` (the
// membership was scheduled to end) and `removed_at` (an admin ended it). Both may be set.
// This mirrors the grant model, where valid_until and revoked_at play the same two roles.
//
// At most one open row may exist per (group_id, user_id). Enforced by the partial unique
// index `group_user_one_open_membership`, defined in the migration SQL because Prisma
// cannot express a partial index. Re-adding a removed member opens a new row rather than
// reviving the old one, so the gap in membership stays visible.
//
// Read through the `active_group_user` view rather than this table wherever the question is
// "who is a member now?". The view applies both closing conditions.
//
// @see docs/design/groups/decisions.md — 1. Membership and collection history are preserved
model group_user {
  // gen_random_uuid() in the database, not uuid() in the client: raw SQL INSERTs on this
  // table would otherwise violate NOT NULL. Declared as dbgenerated so Prisma does not
  // read the database default as drift and generate a migration dropping it.
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  group_id    String
  user_id     String
  role        GROUP_MEMBER_ROLE @default(MEMBER)
  assigned_at DateTime          @default(now()) @db.Timestamp(6)
  assigned_by String?
  valid_until DateTime?         @db.Timestamp(6) // null means "no scheduled end"
  removed_at  DateTime?         @db.Timestamp(6) // null means "still open"
  removed_by  String?

  group    group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user     user  @relation("user_memberships", fields: [user_id], references: [subject_id], onDelete: Cascade)
  assignor user? @relation("membership_assignor", fields: [assigned_by], references: [subject_id], onDelete: SetNull)
  remover  user? @relation("membership_remover", fields: [removed_by], references: [subject_id], onDelete: SetNull)

  @@index([user_id])
  @@index([group_id, user_id])
  @@index([removed_at])
}

/// An invitation for an email address to join a group, whether or not that address has an
/// account yet. The invited email lives in the row rather than in the token, so the server
/// decides who a link belongs to and the token itself decodes to nothing.
///
/// @see docs/design/groups/invitations.md
model group_invitation {
  id       String @id @default(uuid())
  // 256 bits of randomness, base64url. Not a JWT: there is nothing to verify offline, so
  // validity is a row lookup and revocation is a column write.
  token    String @unique @db.VarChar(43)
  group_id String

  // Normalised on write, and compared only against a normalised address.
  invited_email String            @db.VarChar(254)
  role          GROUP_MEMBER_ROLE @default(MEMBER)
  invited_by    String

  status              INVITATION_STATUS @default(PENDING)
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  expires_at          DateTime          @db.Timestamp(6)
  accepted_at         DateTime?         @db.Timestamp(6)
  cancelled_at        DateTime?         @db.Timestamp(6)
  // Why an invitation was not honoured: 'admin_cancelled', 'group_archived'.
  cancellation_reason String?

  group   group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: invited_by is the record of who vouched for this person, and an
  // invitation whose inviter is gone still has to say who sent it.
  inviter user  @relation("invitations_sent", fields: [invited_by], references: [subject_id], onDelete: Restrict)

  @@index([group_id, status])
  @@index([invited_email, status])
}

enum GROUP_MEMBER_ROLE {
  MEMBER
  ADMIN
}

// No EXPIRED member. Expiry is the computed condition `status = 'PENDING' AND expires_at <
// now()`, so expires_at stays the only thing that decides, and no job has to catch up with it.
// @see docs/design/groups/invitations.md — Data Model
enum INVITATION_STATUS {
  PENDING
  ACCEPTED
  CANCELLED
}

model user_dataset_contribution {
  id         Int      @id @default(autoincrement())
  group_id   String
  user_id    String
  dataset_id String
  created_at DateTime @default(now()) @db.Timestamp(6)

  group   group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [user_id], references: [subject_id], onDelete: Cascade)
  dataset dataset @relation(fields: [dataset_id], references: [resource_id], onDelete: Cascade)

  @@unique([group_id, user_id, dataset_id])
  @@index([group_id])
  @@index([user_id])
  @@index([dataset_id])
}

// ============================================================================
// COLLECTIONS - Authorization containers for datasets
// ============================================================================

model collection {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  version     Int     @default(1) // For optimistic concurrency control

  // Ownership (single owning group)
  owner_group_id String
  owner_group    group  @relation(fields: [owner_group_id], references: [id], onDelete: Restrict)

  // Lifecycle
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  archived_at DateTime? @db.Timestamp(6)
  is_archived Boolean   @default(false)

  // Settings
  metadata Json?

  // Relations
  datasets collection_dataset[]
  // Restrict: prevents deleting a resource row directly while this collection still references it.
  // Reverse cascade (collection deleted → resource deleted) is enforced via a DB trigger:
  //   AFTER DELETE ON "collection" FOR EACH ROW: DELETE FROM resource WHERE id = OLD.id
  resource resource             @relation(fields: [id], references: [id], onDelete: Restrict)

  @@index([owner_group_id])
  @@index([is_archived])
}

// Collection membership.
//
// Closed rather than deleted, for the same reason as group_user: a collection grant confers
// access to whatever the collection held at the time, so removing a dataset silently would
// destroy one of the three inputs to "who could read this on a given date?".
//
// At most one open row per (collection_id, dataset_id), enforced by the partial unique index
// `collection_dataset_one_open_membership` in the migration SQL. Read through the
// `active_collection_dataset` view wherever the question is "what is in this collection now?".
//
// @see docs/design/groups/decisions.md — 1. Membership and collection history are preserved
model collection_dataset {
  // gen_random_uuid() in the database, not uuid() in the client: raw SQL INSERTs on this
  // table would otherwise violate NOT NULL. Declared as dbgenerated so Prisma does not
  // read the database default as drift and generate a migration dropping it.
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  collection_id String
  dataset_id    String
  added_at      DateTime  @default(now()) @db.Timestamp(6)
  added_by      String?
  removed_at    DateTime? @db.Timestamp(6) // null means "still in the collection"
  removed_by    String?

  collection collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  dataset    dataset    @relation(fields: [dataset_id], references: [resource_id], onDelete: Cascade)
  adder      user?      @relation("collection_dataset_adder", fields: [added_by], references: [subject_id], onDelete: SetNull)
  remover    user?      @relation("collection_dataset_remover", fields: [removed_by], references: [subject_id], onDelete: SetNull)

  @@index([dataset_id])
  @@index([collection_id, dataset_id])
  @@index([removed_at])
}

// ============================================================================
// GRANTS - Durable authorization facts
//
// Has an exclusion constraint to prevent overlapping grants. Defined in the migration script.
// For the same (subject_id, resource_id, access_type_id) tuple, 
// there must never exist two non-revoked grants whose validity intervals overlap.
// ============================================================================

model grant {
  id String @id @default(uuid())

  // Subject (who receives access)
  subject_id String
  subject    subject @relation(fields: [subject_id], references: [id], onDelete: Restrict)

  // Resource (what is being accessed)
  resource_id String
  resource    resource @relation(fields: [resource_id], references: [id], onDelete: Restrict)

  // Access type (what action is allowed) - atomic granularity by design
  access_type_id Int
  access_type    grant_access_type @relation(fields: [access_type_id], references: [id], onDelete: Restrict)

  // Temporal bounds
  valid_from   DateTime                @default(now()) @db.Timestamp(6)
  valid_until  DateTime?               @db.Timestamp(6) // null means "no expiration"
  valid_period Unsupported("tsrange")? @default(dbgenerated("tsrange(valid_from, valid_until, '[)'::text)"))
  // valid_period is a generated column defined in the migration SQL to leverage PostgreSQL's range types for efficient overlap checks
  // https://github.com/prisma/prisma/discussions/24880#discussioncomment-15783547
  // I had to 1. create migration and edit how we want, 2. apply it, 3. npx prisma db pull, 4. copy the generated column definition from the schema.prisma
  // 4. git reset --hard, 5. paste the generated column definition back into schema.prisma, 6. commit the changes. 
  // Otherwise, Prisma would try to drop and recreate the column on every migration since it doesn't recognize it as a generated column.

  // Provenance
  granted_by        String
  justification     String? // Optional justification for the grant creation or revocation
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  revoked_at        DateTime?           @db.Timestamp(6)
  revoked_by        String?
  revocation_reason String? // Optional reason for revocation
  creation_type     GRANT_CREATION_TYPE // How was this grant created (manual admin action, system bootstrap, access request approval, etc.)

  // The group under whose governance authority this grant was issued.
  // Captures resource.owner_group_id at grant creation time.
  // Cannot be reconstructed after an ownership transfer — the new owner_group_id reflects the
  // new owner, not the group that originally authorized the grant.
  // Useful for: transfer review ("which grants were issued under the prior owner?"),
  // audit queries ("all grants issued under Group X's authority"), and provenance explanation.
  // NULL means the grant was issued by a platform admin acting outside any group's authority.
  issuing_authority_id String?
  issuing_authority    group?  @relation(fields: [issuing_authority_id], references: [id], onDelete: SetNull, name: "grant_issuing_authority")

  // The group under whose governance authority this grant was revoked, if applicable. Same logic as issuing_authority_id.
  revoking_authority_id String?
  revoking_authority    group?  @relation(fields: [revoking_authority_id], references: [id], onDelete: SetNull, name: "grant_revoking_authority")

  // Relations
  grantor user  @relation("grants_created", fields: [granted_by], references: [subject_id], onDelete: Restrict)
  revoker user? @relation("grants_revoked", fields: [revoked_by], references: [subject_id], onDelete: SetNull)

  // If created via access request approval, link back to the request that led to this grant
  source_access_request_id String?
  source_access_request    access_request? @relation(fields: [source_access_request_id], references: [id], onDelete: Restrict)

  // if created via a grant preset (admin, grant creation type - Manual), link back to the preset item that led to this grant
  source_preset_id Int?
  source_preset    grant_preset? @relation(fields: [source_preset_id], references: [id], onDelete: Restrict)

  // valid_period generated column and grant_no_overlap exclusion constraint are defined in the migration SQL
  // For the same (subject_id, resource_id, access_type_id) tuple,
  // there must never exist two non-revoked grants whose validity intervals overlap.

  revocation_type GRANT_REVOCATION_TYPE?

  @@index([subject_id])
  @@index([resource_id])
  @@index([valid_from, valid_until])
}

enum GRANT_CREATION_TYPE {
  ACCESS_REQUEST
  MANUAL
  SYSTEM_BOOTSTRAP
}

enum GRANT_REVOCATION_TYPE {
  MANUAL
  SUPERSEDED
}

model grant_access_type {
  id               Int     @id @default(autoincrement())
  name             String
  description      String?
  long_description String?

  grants               grant[]
  access_request_items access_request_item[]
  presets              grant_preset_item[]
  implies              grant_access_type_implication[] @relation("implying")
  implied_by           grant_access_type_implication[] @relation("implied")

  @@unique([name])
}

/// The partial order over access types. A row reads "implying implies implied": holding
/// implying satisfies any check for implied. Evaluation closes over the table transitively
/// and caches the result, so DATASET:DOWNLOAD satisfies DATASET:VIEW_METADATA through
/// DATASET:LIST_FILES with no edge between them.
///
/// Seeded, and effectively immutable after initial config. The graph must stay acyclic;
/// a test asserts that.
/// @see docs/design/groups/decisions.md — 7. Access types imply one another
/// A reason some action is blocked, independent of any grant.
///
/// Evaluation is `allowed = no restriction blocks this AND some grant permits it`. A
/// restriction never cancels a grant and never references one, so adding a restriction can
/// only narrow access and the order two are applied in does not matter.
///
/// `liftable` is a property of the type rather than of a row. ARCHIVED can be lifted by a
/// platform admin. A future agreement-based restriction should not be liftable at all,
/// only satisfiable.
/// @see docs/design/groups/decisions.md — 6. Restrictions compose by AND; grants stay additive
model restriction_type {
  name        String  @id
  description String
  liftable    Boolean

  restrictions restriction[]
}

/// A condition the donors consented to, recorded on a dataset at registration.
///
/// Nothing enforces these. They are captured because the information decays: the conditions
/// sit on a consent form near the people who ran the study, and reconstructing them later
/// means going through review paperwork study by study.
///
/// `system` names the vocabulary a code belongs to, so a code is machine-readable without
/// this schema having to know any particular ontology. The intended value is 'DUO', the
/// GA4GH Data Use Ontology. No vocabulary is seeded, so nothing validates that a code
/// exists in the system it claims.
/// @see docs/design/groups/decisions.md — 9. Consent codes are captured, not enforced
model dataset_use_condition {
  id         String @id @default(dbgenerated("(gen_random_uuid())::text"))
  dataset_id Int

  /// The vocabulary, e.g. 'DUO'.
  system String
  /// The identifier within that vocabulary, e.g. 'DUO:0000007'.
  code   String
  /// The human-readable term as recorded, kept so the row still means something if the
  /// vocabulary moves or the code is retired.
  label  String?
  /// Free text from the consent form that the code does not capture.
  note   String?

  recorded_at DateTime @default(now()) @db.Timestamp(6)
  recorded_by String?

  dataset  dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  recorder subject? @relation("use_condition_recorder", fields: [recorded_by], references: [id], onDelete: SetNull)

  @@unique([dataset_id, system, code])
  @@index([system, code])
}

/// Who funded the work behind a dataset.
///
/// Attribution is a different relationship from governance. `owner_group_id` says who decides
/// access and nothing else, so it must never be widened to carry credit as well. A dataset may
/// name any number of funding sources, or none.
///
/// "Award" rather than "grant" throughout, because `grant` already means an authorization
/// grant everywhere else in this schema.
///
/// No policy, filter, or grant check reads these rows.
/// @see docs/design/groups/decisions.md — 13. Attribution is its own relationship
model dataset_funding {
  id         String @id @default(dbgenerated("(gen_random_uuid())::text"))
  dataset_id Int

  /// The funding body, as it should appear in a citation, e.g. 'National Institutes of Health'.
  funder       String
  /// The award identifier within that body, e.g. 'R01HG012345'. Null when the funding is
  /// acknowledged without a specific award.
  award_number String?
  /// Anything the two fields above do not carry, such as a sub-award or a co-funding note.
  note         String?

  created_at DateTime @default(now()) @db.Timestamp(6)

  dataset dataset @relation(fields: [dataset_id], references: [id], onDelete: Cascade)

  /// One row per award per dataset, enforced by two partial unique indexes that exist only
  /// in the migration: Prisma does not model a partial unique index, and declaring a plain
  /// three-column one here would produce permanent drift. The restriction table does the same.
  @@index([funder])
}

/// An organisation to credit for a dataset, beyond the group that governs it.
///
/// Exactly one of `group_id` and `organization` is set. A group reference stays current as the
/// group is renamed and gives the page something to link to; free text covers a collaborator
/// who has no presence on this platform.
///
/// No policy, filter, or grant check reads these rows. Adding an affiliation must not widen
/// who can reach a dataset.
/// @see docs/design/groups/decisions.md — 13. Attribution is its own relationship
model dataset_affiliation {
  id         String @id @default(dbgenerated("(gen_random_uuid())::text"))
  dataset_id Int

  /// A group on this platform. Mutually exclusive with `organization`.
  group_id     String?
  /// An organisation with no presence here. Mutually exclusive with `group_id`.
  organization String?
  /// What the affiliation is, e.g. 'Data collection' or 'Analysis'. Free text on purpose:
  /// contribution taxonomies are a research question, not a schema decision.
  role         String?

  created_at DateTime @default(now()) @db.Timestamp(6)

  dataset dataset @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  group   group?  @relation("dataset_affiliation_group", fields: [group_id], references: [id], onDelete: Cascade)

  @@index([dataset_id])
  @@index([group_id])
}

/// One restriction in force, attached to either a group or a resource.
///
/// A restriction on a group applies to the group, its descendants, and the resources those
/// groups govern. A restriction on a resource applies to that resource alone.
///
/// Rows are closed rather than deleted, the same way memberships are, so the history of
/// what was restricted and by whom survives lifting.
/// @see docs/design/groups/decisions.md — 6. Restrictions compose by AND; grants stay additive
model restriction {
  id        String @id @default(dbgenerated("(gen_random_uuid())::text"))
  type_name String

  /// Exactly one of these is set; a CHECK constraint enforces that.
  group_id    String?
  resource_id String?

  applied_at DateTime  @default(now()) @db.Timestamp(6)
  applied_by String?
  lifted_at  DateTime? @db.Timestamp(6)
  lifted_by  String?
  reason     String?

  type     restriction_type @relation(fields: [type_name], references: [name], onDelete: Restrict)
  group    group?           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  resource resource?        @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  applier  subject?         @relation("restriction_applier", fields: [applied_by], references: [id], onDelete: SetNull)
  lifter   subject?         @relation("restriction_lifter", fields: [lifted_by], references: [id], onDelete: SetNull)

  @@index([group_id, lifted_at])
  @@index([resource_id, lifted_at])
  @@index([type_name])
}

model grant_access_type_implication {
  implying_id Int
  implied_id  Int

  implying grant_access_type @relation("implying", fields: [implying_id], references: [id], onDelete: Cascade)
  implied  grant_access_type @relation("implied", fields: [implied_id], references: [id], onDelete: Cascade)

  @@id([implying_id, implied_id])
  @@index([implied_id])
}

// Platform-seeded, effectively immutable after initial config.
// Defined by platform admins; referenced by group admins and requesters.

model grant_preset {
  id               Int             @id @default(autoincrement())
  name             String          @unique // "Standard Researcher Access"
  description      String?
  long_description String?
  is_active        Boolean         @default(true) // soft-disable; never delete
  resource_types   RESOURCE_TYPE[] // which resource types this preset can be applied to (DATASET, COLLECTION, etc.)

  access_type_items    grant_preset_item[]
  access_request_items access_request_item[]
  grants               grant[]
}

model grant_preset_item {
  preset_id      Int
  access_type_id Int

  preset      grant_preset      @relation(fields: [preset_id], references: [id], onDelete: Cascade)
  access_type grant_access_type @relation(fields: [access_type_id], references: [id], onDelete: Restrict)

  @@id([preset_id, access_type_id])
}

// ============================================================================
// ACCESS REQUESTS - Workflow objects (not authorization primitives)
// ============================================================================

model access_request {
  id String @id @default(uuid())

  // Request type
  type ACCESS_REQUEST_TYPE

  // Target resource
  resource_id String
  resource    resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  // Requester — who filed the request
  requester_id String
  requester    user   @relation("access_requests_created", fields: [requester_id], references: [subject_id], onDelete: Restrict)

  // Subject — who/what the request is for (USER or GROUP)
  // For self-requests: subject_id == requester_id (the user's subject_id)
  // For group requests: subject_id == group.id (which equals group.subject_id)
  subject_id String
  subject    subject @relation(fields: [subject_id], references: [id], onDelete: Restrict)

  // Justification
  purpose String?

  // Prior context (for renewals)
  previous_grant_ids String[] // References expired grants

  // Status
  status ACCESS_REQUEST_STATUS @default(DRAFT)

  // Review
  reviewed_by     String?
  reviewed_at     DateTime? @db.Timestamp(6)
  decision_reason String?

  // Lifecycle
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  submitted_at DateTime? @db.Timestamp(6)
  closed_at    DateTime? @db.Timestamp(6)

  // Relations
  reviewer user? @relation("access_requests_reviewed", fields: [reviewed_by], references: [subject_id], onDelete: SetNull)

  access_request_items access_request_item[]
  grants               grant[]

  @@index([requester_id, status])
  @@index([subject_id, status])
  @@index([resource_id, status])
  @@index([status])
}

// access_type_id and preset_id are strictly mutually exclusive - exactly one must be non-null to indicate whether this item is for a specific access type or an entire preset. 
// This is enforced by DB constraint check defined in the migration SQL
model access_request_item {
  id                String @id @default(uuid())
  access_request_id String

  access_type_id Int? // What was requested
  preset_id      Int? // If applicable, which preset(s) was requested that includes this access type

  requested_until DateTime?
  approved_until  DateTime?
  decision        ACCESS_REQUEST_ITEM_DECISION @default(PENDING) // Review outcome

  access_request access_request     @relation(fields: [access_request_id], references: [id], onDelete: Cascade)
  access_type    grant_access_type? @relation(fields: [access_type_id], references: [id], onDelete: Restrict)
  preset         grant_preset?      @relation(fields: [preset_id], references: [id], onDelete: Restrict)

  // Prevent Duplicate Items Inside Same Request
  @@unique([access_request_id, access_type_id]) // no duplicate access types within the same request
  @@unique([access_request_id, preset_id]) // no duplicate presets within the same request
}

enum ACCESS_REQUEST_TYPE {
  NEW
  RENEWAL
}

enum ACCESS_REQUEST_STATUS {
  DRAFT
  UNDER_REVIEW
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ACCESS_REQUEST_ITEM_DECISION {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// AUDIT LOG - Authorization events
// ============================================================================

// partitioned by timestamp in the migration
// monthly partitions named like authorization_audit_2026_01, authorization_audit_2026_02, etc.
model authorization_audit {
  id        Int      @default(autoincrement())
  timestamp DateTime @default(now()) @db.Timestamp(6)

  // Event type
  event_type String

  // Actor — who performed the action
  actor_id   String?
  actor_name String? // Snapshot of actor name at write-time
  actor      user?   @relation(fields: [actor_id], references: [subject_id], onDelete: SetNull)

  // Subject — secondary entity: user added to group, dataset added to collection, etc.
  subject_id   String?
  subject_name String? // Snapshot of subject name at write-time
  subject_type String? // 'USER', 'GROUP'

  // Resource - affected resource: dataset, collection, etc.
  resource_id   String?
  resource_type String? // 'DATASET', 'COLLECTION', etc.
  resource_name String? // Snapshot of resource name at write-time

  // Target — the thing being changed (collection, dataset, grant, etc.)
  target_id   String?
  target_name String? // Snapshot of target name at write-time
  target_type String? // 'DATASET', 'COLLECTION', 'GRANT', etc

  // Details
  action   String? // 'create', 'revoke', 'approve', 'reparent', etc.
  metadata Json? // Event-specific details only (no names)

  // Authorization decision context (for access checks)
  decision Boolean?
  reason   String?

  @@id([id, timestamp]) // include timestamp in primary key to allow partitioning by time
  @@index([event_type, timestamp])
  @@index([actor_id])
  @@index([subject_id])
  @@index([target_id])
}

// ============================================================================
// AUTHORITY TRANSFERS - Ownership mutation workflow
// ============================================================================

model authority_transfer {
  id String @id @default(uuid())

  // Generic resource reference
  resource_type AUTH_RESOURCE_TYPE
  resource_id   String

  // Ownership mutation
  source_principal_type PRINCIPAL_TYPE
  source_principal_id   String

  target_principal_type PRINCIPAL_TYPE
  target_principal_id   String

  proposed_by String
  reason      String?

  status AUTH_TRANSFER_STATUS @default(PENDING)

  // Approval tracking
  source_approved_at DateTime?
  source_approved_by String?

  target_approved_at DateTime?
  target_approved_by String?

  executed_at DateTime?
  executed_by String?

  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum PRINCIPAL_TYPE {
  USER
  GROUP
}

enum AUTH_RESOURCE_TYPE {
  DATASET
  COLLECTION
}

enum AUTH_TRANSFER_STATUS {
  PENDING
  SOURCE_APPROVED
  TARGET_APPROVED
  APPROVED // both sides approved
  EXECUTED
  REJECTED
  CANCELLED
  EXPIRED
}

// ================ END OF GROUPS AND AUTHORIZATION MODELS ================

model import_source {
  id           Int      @id @default(autoincrement())
  path         String   @unique
  mounted_path String?
  label        String?
  description  String?
  sort_order   Int?
  owner_id     Int?
  owner        user?    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(6)
  metadata     Json?

  // The group whose members may browse and import from this source. Nullable: a source with
  // no group stays reachable through the legacy browse routes, which are global. The v2
  // routes serve only sources that name a group.
  // @see docs/design/groups/dataset-creation-plan.md — B1
  owner_group_id String?
  owner_group    group?  @relation(fields: [owner_group_id], references: [id], onDelete: Restrict)

  // ACTIVE accepts imports. SUSPENDED is listed and refuses them, which is what an
  // unreadable path becomes. RETIRED is neither listed nor importable. A source is never
  // deleted, because datasets imported from it still hold paths underneath it.
  status IMPORT_SOURCE_STATUS @default(ACTIVE)

  // Provenance of the decision to trust this path. A group admin asks, a platform admin
  // confirms the path is readable by the API and the workers, and inserts the row.
  requested_by_id  Int?
  requested_by     user?     @relation("import_source_requester", fields: [requested_by_id], references: [id], onDelete: SetNull)
  approved_by_id   Int?
  approved_by      user?     @relation("import_source_approver", fields: [approved_by_id], references: [id], onDelete: SetNull)
  approved_at      DateTime? @db.Timestamp(6)
  // Last time a scheduled check confirmed the path is readable. An unmounted path returns an
  // empty listing, which a user reads as "my data is gone"; the check says so instead.
  path_verified_at DateTime? @db.Timestamp(6)
  status_reason    String?

  @@index([owner_group_id])
  @@index([status])
}

enum IMPORT_SOURCE_STATUS {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum access_type {
  BROWSER
  SLATE_SCRATCH
}

enum upload_status {
  UPLOADING
  UPLOAD_FAILED
  UPLOADED
  VERIFYING // Integrity verification in progress (async Celery task)
  VERIFIED // Integrity verified, ready to trigger 'Integrated' workflow
  VERIFICATION_FAILED // Integrity check failed before registering the uploaded dataset into the system
  PROCESSING
  PROCESSING_FAILED
  COMPLETE
  PERMANENTLY_FAILED // After 3 retry attempts; no further automatic retries
}

enum upload_type {
  // FILE
  // DIRECTORY
  DATASET
}

enum DATASET_CREATE_METHOD {
  UPLOAD
  IMPORT
  SCAN
  ON_DEMAND
}

enum ALERT_TYPE {
  INFO
  WARNING
  ERROR
}
