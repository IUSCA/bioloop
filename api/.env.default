# in test and production deployments set NODE_ENV accordingly
NODE_ENV=docker
E2E_ADMIN=e2eAdmin
E2E_OPERATOR=e2eOperator
E2E_USER=e2eUser

POSTGRES_HOST=postgres
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}"

WORKFLOW_SERVER_BASE_URL=http://rhythm:5001
WORKFLOW_AUTH_TOKEN=xxx


OAUTH_BASE_URL=http://signet:5050

# If using local dev setup do not change the following oauth values
OAUTH_DOWNLOAD_CLIENT_ID=xxx
OAUTH_DOWNLOAD_CLIENT_SECRET=xxx

GOOGLE_OAUTH_CLIENT_ID=example
GOOGLE_OAUTH_CLIENT_SECRET=example

CILOGON_OAUTH_CLIENT_ID=example
CILOGON_OAUTH_CLIENT_SECRET=example

MICROSOFT_OAUTH_CLIENT_ID=example
MICROSOFT_OAUTH_CLIENT_SECRET=example

DOWNLOAD_SERVER_BASE_URL=http://localhost:3060


# The upload directory as every process OTHER than the API sees it. It becomes the
# prefix of dataset.origin_path, so a worker can open the files the API wrote. In
# production this is also the bind-mount source in docker-compose-prod.yml.
UPLOAD_HOST_DIR=/opt/sca/data/uploads

# UPLOAD_API_DIR is the same directory as the API process itself sees it, and is
# what every filesystem call in the API uses. In the container the two differ, and
# api/config/default.json already holds the container value, so nothing needs to set
# it here. IMPORT_SOURCES_DIR is the directory holding the browsable import sources.
#
# Both are needed only when running the API outside the container, and both must be
# absolute — a relative path resolves against each process's own working directory,
# so the API and a worker would disagree about where a file is:
#
#   UPLOAD_API_DIR=/absolute/path/to/bioloop/data/uploads
#   IMPORT_SOURCES_DIR=/absolute/path/to/bioloop/data/import
#
# Set them in api/.env, not here: adding a key to this file makes dotenv-safe require
# it of every developer. See docs/guides/workers-local.md.


# JUPYTERHUB
HUB_BASE_URL=http://localhost:8000
HUB_API_URL=http://localhost:8000/hub/api
HUB_AUTH_TOKEN=example
HUB_TICKET_SECRET=example
