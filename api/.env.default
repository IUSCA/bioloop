# in test and production deployments set NODE_ENV accordingly
NODE_ENV=docker
E2E_ADMIN=e2eAdmin
E2E_OPERATOR=e2eOperator
E2E_USER=e2eUser

POSTGRES_HOST=postgres
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}"

WORKFLOW_SERVER_BASE_URL=http://rhythm:5001
WORKFLOW_AUTH_TOKEN=xxx


OAUTH_BASE_URL=http://signet:5050

# If using local dev setup do not change the following oauth values
OAUTH_DOWNLOAD_CLIENT_ID=xxx
OAUTH_DOWNLOAD_CLIENT_SECRET=xxx

GOOGLE_OAUTH_CLIENT_ID=example
GOOGLE_OAUTH_CLIENT_SECRET=example

CILOGON_OAUTH_CLIENT_ID=example
CILOGON_OAUTH_CLIENT_SECRET=example

MICROSOFT_OAUTH_CLIENT_ID=example
MICROSOFT_OAUTH_CLIENT_SECRET=example

DOWNLOAD_SERVER_BASE_URL=http://localhost:3060


UPLOAD_HOST_DIR=/opt/sca/data/uploads

# Where the API stages and stores uploaded files, and where the import UI is allowed to
# browse. Both must be absolute, and both must name a path the workers also see, because
# a worker later archives from the dataset's origin_path. The docker values are the
# defaults in api/config/default.json, so these two are only needed when running the API
# outside the container:
#
#   UPLOAD_DIR=/absolute/path/to/bioloop/data/uploads
#   IMPORT_SOURCES_DIR=/absolute/path/to/bioloop/data/import
#
# Set them in api/.env, not here: adding a key to this file makes dotenv-safe require it
# of every developer. See docs/guides/workers-local.md.


# JUPYTERHUB
HUB_BASE_URL=http://localhost:8000
HUB_API_URL=http://localhost:8000/hub/api
HUB_AUTH_TOKEN=example
HUB_TICKET_SECRET=example
