# Template for running the workers natively (no docker) on a developer machine.
# Copy to workers/.env and fill in APP_API_TOKEN.
#
#   cp workers/.env.dev.example workers/.env
#   (cd api && node src/scripts/issue_token.js svc_tasks)   # paste into APP_API_TOKEN
#
# See .claude/skills/workers-dev/SKILL.md for the whole procedure.

# Selects workers/workers/config/dev.py, which roots every path at ./data.
APP_ENV=dev

# The API, run by bin/devserver.sh.
API_BASE_URL=http://localhost:3030

# A never-expiring JWT for the seeded svc_tasks service account. Reissue it
# after `prisma migrate reset`, which gives svc_tasks a new subject_id.
APP_API_TOKEN=

# Celery result backend. Must be the MongoDB the rhythm API also talks to,
# otherwise the UI shows workflows with no task results.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=celery
MONGO_AUTH_SOURCE=admin
MONGO_USER=root
MONGO_PASS=example

# Celery broker. The vhost is part of QUEUE_URL, after the port.
QUEUE_URL=localhost:5672/myvhost
QUEUE_USER=user
QUEUE_PASS=password

# Salt for the staging-path alias. Any value works in dev.
ALIAS_SALT=example
