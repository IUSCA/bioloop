FROM node:22-bookworm-slim AS app
ARG SERVICE=api
WORKDIR /opt/sca/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN if [ -f prisma/schema.prisma ]; then \
    DATABASE_URL=postgresql://preview:preview@localhost:5432/preview npx prisma generate; fi
CMD ["node", "src/index.js"]

FROM app AS ui-build
# The current Vite config reads local certificates even for production builds.
# These build-only certificates never terminate public preview traffic.
RUN mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout .cert/key.pem -out .cert/cert.pem -days 1 -subj /CN=localhost
ENV VITE_PREVIEW_MODE=true \
    VITE_UPLOAD_MAX_FILE_SIZE_BYTES=26214400 \
    VITE_UPLOAD_MAX_CONCURRENT_UPLOADS=2 \
    VITE_UPLOAD_TUS_CHUNK_SIZE_BYTES=2097152 \
    NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build -- --mode ci

FROM nginx:1.28-alpine AS ui
COPY --from=ui-build /opt/sca/app/dist /usr/share/nginx/html
