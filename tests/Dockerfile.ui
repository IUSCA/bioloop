# Test-only image: build the checked-out UI without changing production deployment.
FROM node:24-alpine AS build

WORKDIR /opt/sca/app
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY ui/ ./
COPY ui/.env.default .env.production
RUN npm run build

FROM nginx:1.31.3-alpine
COPY tests/nginx.e2e.conf /etc/nginx/conf.d/default.conf
COPY --from=build /opt/sca/app/dist/ /opt/sca/ui/
EXPOSE 443
